# Vault Configuration for External Vault / OpenBao Server
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   vi .env

# Vault / OpenBao server address
VAULT_ADDR=http://localhost:8200

# Vault authentication token
VAULT_TOKEN=your-vault-token-here

# ============================================================================
# Usage:
#   1. Configure your Vault connection above
#   2. Load environment variables (IMPORTANT: use set -a to export):
#        set -a && source .env && set +a
#   3. Run OpenTofu:
#        tofu init
#        tofu plan
#        tofu apply
# ============================================================================
