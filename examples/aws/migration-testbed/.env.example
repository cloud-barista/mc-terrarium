# Vault Configuration for External Vault Server
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   vi .env

# Vault server address
# Example: http://vault.example.com:8200
VAULT_ADDR=http://localhost:8200

# Vault authentication token
# Get this from your Vault administrator or generate via Vault CLI
# Example: vault login -method=userpass username=myuser
VAULT_TOKEN=your-vault-token-here

# Optional: Vault namespace (for Vault Enterprise)
# VAULT_NAMESPACE=your-namespace

# ============================================================================
# Usage:
#   1. Configure your Vault connection above
#   2. Load environment variables (IMPORTANT: use set -a to export):
#        set -a && source .env && set +a
#   3. Verify Vault connection:
#        curl -s -H "X-Vault-Token: $VAULT_TOKEN" $VAULT_ADDR/v1/sys/health
#   4. Run OpenTofu:
#        tofu init
#        tofu plan
#        tofu apply
#
# Note: Using 'set -a' ensures all variables are exported to child processes.
#       Plain 'source .env' will NOT work because variables won't be exported.
# ============================================================================

# Note: This file should be added to .gitignore to prevent token exposure
